{
 "name": "rjrt",
 "source": { "origin": "https://rjrt.com" },
 "rebuild": {
  "origin": "http://localhost:3017",
  "preview": "https://{ref}--rjrt--adobedrago.aem.page",
  "repo": "..",
  "da": { "org": "AdobeDrago", "site": "rjrt" }
 },
 "access": { "mode": "live", "profileDir": "work/.browser-profile" },
 "widths": [1440, 1280],
 "height": 900,
 "blockRequests": [],
 "hide": [],
 "invisible": [],
 "freezeCss": [],
 "hideIframes": true,
 "consent": true,
 "video": { "providers": "all" },
 "carousels": ["slick", "swiper", "hook"],
 "scroll": { "max": 20000, "step": 500, "wait": 150 },
 "gate": { "pixel": 0.99, "tolerance": 0.5, "threshold": 0.1 }
}
